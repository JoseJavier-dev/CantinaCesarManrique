<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado presionado (más oscuro) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C8102E"/>     <!-- Rojo oscuro McDonald's al pulsar -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E30613"/>     <!-- Rojo brillante McDonald's -->
            <corners android:radius="16dp"/>
        </shape>
    </item>

</selector>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_estilo"
            android:text="🛒"
            android:textSize="24sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvComposicion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Composición"/>

    <TextView
        android:id="@+id/tvAlergenos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alérgenos"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPrecioOriginal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio original"
            android:textColor="#FF0000"/>

        <TextView
            android:id="@+id/tvPrecioNuevo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Precio nuevo"/>
    </LinearLayout>

</LinearLayout>